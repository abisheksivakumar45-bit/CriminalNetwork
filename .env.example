# ─── Configuration template ─────────────────────────────────────────────
# Copy to `.env` (which is git-ignored) and fill in real values.
# Values below are SAFE PLACEHOLDERS ONLY — never commit secrets.

# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Backend CORS (comma-separated origins; used for credentialed requests)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ────────────────────────────────────────────────────────────────────────
# Authentication / RBAC
# ────────────────────────────────────────────────────────────────────────
# JWT signing secret — generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me-to-a-long-random-secret

# Token lifetimes
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie security: false for local HTTP, true behind HTTPS
AUTH_COOKIE_SECURE=false

# DEMO accounts seeded at startup. These are DEMO-ONLY credentials —
# replace with strong per-user passwords for anything beyond a prototype.
AUTH_DEMO_ENABLED=true
AUTH_DEMO_ADMIN_USERNAME=admin
AUTH_DEMO_ADMIN_PASSWORD=ChangeThisDemoPassword
AUTH_DEMO_ADMIN_DISPLAY_NAME=System Administrator
AUTH_DEMO_ADMIN_EMAIL=admin@crimenet.demo
AUTH_DEMO_INVESTIGATOR_USERNAME=investigator
AUTH_DEMO_INVESTIGATOR_PASSWORD=ChangeThisDemoPassword
AUTH_DEMO_INVESTIGATOR_DISPLAY_NAME=Senior Investigator
AUTH_DEMO_INVESTIGATOR_EMAIL=investigator@crimenet.demo
AUTH_DEMO_ANALYST_USERNAME=analyst
AUTH_DEMO_ANALYST_PASSWORD=ChangeThisDemoPassword
AUTH_DEMO_ANALYST_DISPLAY_NAME=Intelligence Analyst
AUTH_DEMO_ANALYST_EMAIL=analyst@crimenet.demo

# Basic brute-force protection
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=300